{
    "schemaVersion":  1,
    "id":  "better_player_model",
    "version":  "1.0.7-fabric-1.20.1",
    "name":  "Better Player Model",
    "description":  "A powerful tool for replacing and animating player models. Features universal compatibility with .ysm models via integrated OpenYSM technology. Based on Yes_Steve_Model.",
    "authors":  [
                    "Zhoporez (Adapter)",
                    "Micaftic (FoxModelLoader)",
                    "Elfmcys (Original Author)",
                    "OpenYSM Team"
                ],
    "contact":  {
                    "homepage":  ""
                },
    "license":  "MIT",
    "icon":  "BetterPlayerModel.png",
    "environment":  "*",
    "entrypoints":  {
                        "main":  [
                                     "com.elfmcys.yesstevemodel.fabric.YesSteveModelFabric"
                                 ],
                        "client":  [
                                       "com.elfmcys.yesstevemodel.fabric.client.YesSteveModelFabricClient"
                                   ],
                        "cardinal-components-entity":  [
                                                           "com.elfmcys.yesstevemodel.fabric.YsmComponents"
